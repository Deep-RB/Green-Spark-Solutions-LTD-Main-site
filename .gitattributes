# Normalise text in the repo, leave the working tree to the platform.
* text=auto

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
*.py     text eol=lf
*.txt    text eol=lf

# Binary assets — never touch, never diff.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.webm   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.pdf    binary
