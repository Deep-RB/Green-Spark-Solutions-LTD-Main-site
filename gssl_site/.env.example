# Copy to .env and fill in. Never commit .env.

# A long random string, unique per server. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Comma-separated hostnames this site answers on.
DJANGO_ALLOWED_HOSTS=greensparksolutions.com,www.greensparksolutions.com

# Canonical origin used for canonical links, Open Graph and share URLs.
DJANGO_SITE_URL=https://greensparksolutions.com

# Set to 0 if TLS is terminated by this process rather than a proxy.
DJANGO_BEHIND_PROXY=1
DJANGO_SECURE_SSL_REDIRECT=1

# The design-build preview ribbon. Always 0 in production.
DJANGO_SHOW_PREVIEW_RIBBON=0
